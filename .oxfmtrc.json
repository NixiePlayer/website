{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": false,
  "arrowParens": "always",
  "quoteProps": "as-needed",
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "app/globals.css",
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.tsbuildinfo",
    ".next",
    "next-env.d.ts",
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "*.md"
  ]
}
